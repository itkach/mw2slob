#!/usr/bin/env sh
# update-mathjax - Install MathJax 4 for mw2slob
#
# This script installs MathJax 4 and copies the necessary files
# to mw2slob/MathJax/ for browser use.
#
# Usage: ./update-mathjax [destination]
#   destination: path to mw2slob directory (default: the mw2slob
#   directory next to this script)

set -e

PROJECT_DIR="$(cd "$(dirname "$0")" && pwd)"
DEST="${1:-$PROJECT_DIR/mw2slob}/MathJax"
MJX_PKG="mathjax"

echo "MathJax 4 update for mw2slob"
echo "Destination: $DEST"
echo "Project directory: $PROJECT_DIR"

# Create destination directory
mkdir -p "$DEST"

# Install the prebuilt MathJax 4 package into a temporary directory,
# removed on exit, so the project has no npm files of its own
NPM_DIR="$(mktemp -d "${TMPDIR:-/tmp}/update-mathjax.XXXXXX")"
trap 'rm -rf "$NPM_DIR"' EXIT
trap 'exit 1' INT TERM
echo "Installing $MJX_PKG@4..."
npm install --prefix "$NPM_DIR" --no-audit --no-fund "$MJX_PKG@4" 2>&1 | tail -3

# Verify installation
MJX_DIR="$NPM_DIR/node_modules/$MJX_PKG"
if [ ! -d "$MJX_DIR" ]; then
  echo "ERROR: $MJX_DIR does not exist" >&2
  exit 1
fi

# Copy MathJax bundle files
echo "Copying MathJax 4 files..."

# Copy the tex-svg bundle (TeX input + SVG output)
if [ ! -f "$MJX_DIR/tex-svg.js" ]; then
  echo "ERROR: $MJX_DIR/tex-svg.js not found" >&2
  exit 1
fi
cp "$MJX_DIR/tex-svg.js" "$DEST/"
echo "  Copied tex-svg.js"

# Copy the handful of TeX extensions that aren't compiled into
# tex-svg.js itself so the "autoload" package can fetch them on demand
# from a same-origin/relative path, offline.
mkdir -p "$DEST/input/tex/extensions"
for ext in boldsymbol mhchem color cancel unicode; do
  if [ ! -f "$MJX_DIR/input/tex/extensions/$ext.js" ]; then
    echo "ERROR: $MJX_DIR/input/tex/extensions/$ext.js not found" >&2
    exit 1
  fi
  cp "$MJX_DIR/input/tex/extensions/$ext.js" "$DEST/input/tex/extensions/"
  echo "  Copied input/tex/extensions/$ext.js"
done

# Copy the font chunks tex-svg.js loads on demand for less common
# character blocks, from the font package mathjax depends on, so they
# stay at the same version as tex-svg.js. The directory is replaced
# rather than merged so chunks dropped by a new version don't linger.
FONT_DIR="$NPM_DIR/node_modules/@mathjax/mathjax-newcm-font/svg/dynamic"
if [ ! -d "$FONT_DIR" ]; then
  echo "ERROR: $FONT_DIR does not exist" >&2
  exit 1
fi
rm -rf "$DEST/fonts/mathjax-newcm-font/svg/dynamic"
mkdir -p "$DEST/fonts/mathjax-newcm-font/svg"
cp -R "$FONT_DIR" "$DEST/fonts/mathjax-newcm-font/svg/"
echo "  Copied fonts/mathjax-newcm-font/svg/dynamic"

# Copy texvc and wiki2jax extensions from mathjax/ directory
if [ ! -f "$PROJECT_DIR/mathjax/extensions/texvc.js" ]; then
  echo "ERROR: $PROJECT_DIR/mathjax/extensions/texvc.js not found" >&2
  exit 1
fi
cp "$PROJECT_DIR/mathjax/extensions/texvc.js" "$DEST/"
echo "  Copied texvc.js"

if [ ! -f "$PROJECT_DIR/mathjax/extensions/wiki2jax.js" ]; then
  echo "ERROR: $PROJECT_DIR/mathjax/extensions/wiki2jax.js not found" >&2
  exit 1
fi
cp "$PROJECT_DIR/mathjax/extensions/wiki2jax.js" "$DEST/"
echo "  Copied wiki2jax.js"

# Copy the MediaWiki config
if [ ! -f "$PROJECT_DIR/mw2slob/MathJax/MediaWiki.js" ]; then
  echo "ERROR: $PROJECT_DIR/mw2slob/MathJax/MediaWiki.js not found" >&2
  exit 1
fi
# With the default destination the config is already in place
if [ "$PROJECT_DIR/mw2slob/MathJax/MediaWiki.js" -ef "$DEST/MediaWiki.js" ]; then
  echo "  MediaWiki.js already in place"
else
  cp "$PROJECT_DIR/mw2slob/MathJax/MediaWiki.js" "$DEST/"
  echo "  Copied MediaWiki.js"
fi

# Record the installed package versions. The record is kept outside
# mw2slob/MathJax/, whose contents go into every dictionary, and is
# written only when updating the project's own copy, since it describes
# that copy.
VERSIONS="$(for pkg in mathjax @mathjax/mathjax-newcm-font; do
  echo "$pkg@$(node -p 'require(process.argv[1]).version' "$NPM_DIR/node_modules/$pkg/package.json")"
done)"
echo ""
echo "Installed versions:"
echo "$VERSIONS" | sed 's/^/  /'
if [ "$PROJECT_DIR/mw2slob/MathJax" -ef "$DEST" ]; then
  echo "$VERSIONS" > "$PROJECT_DIR/mathjax/versions.txt"
  echo "  Recorded in mathjax/versions.txt"
fi

echo ""
echo "MathJax 4 update complete!"
echo "Files in $DEST:"
ls -la "$DEST/"
